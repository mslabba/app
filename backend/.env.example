# Application
APP_ENV=development
# firestore (default production path) | postgres (staging target)
DATA_BACKEND=firestore

# PostgreSQL (Railway staging/production)
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/railway

# Firebase — prefer READ-ONLY service account for inventory/export
FIREBASE_CREDENTIALS_PATH=./firebase-admin-readonly.json
# FIREBASE_CREDENTIALS_JSON=
# FIREBASE_PROJECT_ID=

# Enforce read-only policy for migration tooling (never set false in production tooling)
FIRESTORE_READ_ONLY=true

MIGRATION_OUTPUT_DIR=./migration_output

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
