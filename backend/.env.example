# Application
APP_ENV=development
# firestore (default production path) | postgres (local Homebrew/Docker / future staging)
DATA_BACKEND=firestore

# Local Homebrew Postgres (port 5432) — preferred when Docker is unavailable
# DATABASE_URL=postgresql+psycopg://powerauction:powerauction@localhost:5432/powerauction
# ./scripts/local_native_pg_setup.sh

# Local Docker Postgres (port 5434) — see docs/LOCAL_POSTGRES_SETUP.md and docker-compose.yml
# DATABASE_URL=postgresql+psycopg://powerauction:powerauction@localhost:5434/powerauction

# PostgreSQL (Railway staging/production — only when you intentionally switch)
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/railway

# Firebase Auth (JWT) — still required even with DATA_BACKEND=postgres
FIREBASE_CREDENTIALS_PATH=./firebase-admin.json
# For read-only inventory/export tooling, use a RO key instead:
# FIREBASE_CREDENTIALS_PATH=./firebase-admin-readonly.json
# FIREBASE_CREDENTIALS_JSON=
# FIREBASE_PROJECT_ID=

# Enforce read-only policy for migration tooling (never set false in production tooling)
FIRESTORE_READ_ONLY=true

MIGRATION_OUTPUT_DIR=./migration_output

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Optional local Cashfree (used when DATA_BACKEND=postgres and no row in payment_gateway_settings)
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_MODE=sandbox
